# Every setting gridwatch reads, with its default. gridwatch reads environment variables
# only (it does not load .env files), so export the ones you want to change, for example
#   set -a; . ./.env; set +a
# No secrets are needed: both data sources are public.

# Where raw Parquet, the DuckDB warehouse and model outputs are written.
GRIDWATCH_DATA_DIR=data

# First half-hour to ingest for each dataset (ISO 8601, UTC). Moving a date earlier
# backfills the gap on the next run.
GRIDWATCH_NATIONAL_START=2017-09-26
GRIDWATCH_GENERATION_START=2018-05-10T23:30
GRIDWATCH_REGIONAL_START=2023-01-01

# Days of recent history re-requested on every run, because the API revises actuals.
GRIDWATCH_REFETCH_DAYS=2

# Politeness and resilience for the Carbon Intensity API.
GRIDWATCH_MIN_REQUEST_INTERVAL=1.0
GRIDWATCH_MAX_ATTEMPTS=5
GRIDWATCH_HTTP_TIMEOUT=60

# Memory limit for DuckDB during the dbt build.
GRIDWATCH_DUCKDB_MEMORY=2GB
